# VentAxis Solutions — Environment Variables Template
# Copy this file to .env.local and fill in your credentials. Never commit real secrets.

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://ventaxis.co.za

# Supabase PostgreSQL Database (Optional — falls back to reactive local persistence if omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SMTP / Nodemailer Configuration for Server-Side Enquiry Dispatch (/api/enquiry)
SMTP_HOST=smtp.example.co.za
SMTP_PORT=587
SMTP_USER=info@afrismmehub.co.za
SMTP_PASS=your-smtp-password-here
SMTP_FROM="VentAxis Solutions <info@afrismmehub.co.za>"
ENQUIRY_RECIPIENT_EMAIL=info@afrismmehub.co.za
