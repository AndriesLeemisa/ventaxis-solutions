# VentAxis Solutions - Environment Variables
# If provided, the web application and admin dashboard will sync live with your remote Supabase PostgreSQL database.
# If omitted, VentAxis Solutions runs seamlessly in offline/local reactive database mode.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
